# Local-only values for `docker compose`. Copy to `.env` and adjust if needed.
# These are NOT the app's OAuth client secrets — those are exported separately
# when you run the Spring app (KEYCLOAK_M2M_CLIENT_SECRET / KEYCLOAK_LOGIN_CLIENT_SECRET).

# PostgreSQL that backs Keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak
POSTGRES_DB=keycloak

# Keycloak image version + bootstrap admin (local only)
KEYCLOAK_VERSION=26.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# pgAdmin login (local only)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
